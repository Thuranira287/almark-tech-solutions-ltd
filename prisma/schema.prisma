// Prisma schema — PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  pending
  partially_paid
  paid
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
}

enum PaymentMethod {
  mpesa
  paypal
  creditcard
}

enum TestimonialStatus {
  pending
  approved
  rejected
}

model Testimonial {
  id          String            @id @default(cuid())
  name        String
  email       String
  company     String?
  projectName String?
  rating      Int 
  message     String
  status      TestimonialStatus @default(pending)
  createdAt   DateTime          @default(now())

  @@map("testimonials")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  totpSecret   String? 
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@map("admin_users")
}

model Service {
  id          String   @id 
  category    String
  name        String
  description String
  basePrice   Int
  priceRange  String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteServices QuoteService[]

  @@map("services")
}

model Quote {
  id          String      @id @default(cuid())
  quoteRef    String      @unique 
  customerName  String
  customerEmail String
  customerPhone String
  company     String?
  message     String?
  totalPrice  Int 
  paidAmount  Int         @default(0)
  status      QuoteStatus @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  services QuoteService[]
  payments Payment[]

  @@map("quotes")
}

model QuoteService {
  id        String  @id @default(cuid())
  quoteId   String
  serviceId String
  priceAtQuote Int 

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([quoteId, serviceId])
  @@map("quote_services")
}

model Payment {
  id          String        @id @default(cuid())
  quoteId     String
  method      PaymentMethod
  amount      Int 
  currency    String        @default("KES")
  status      PaymentStatus @default(pending)
  providerRef String?       @unique 
  rawCallback Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("payments")
}
